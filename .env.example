# Provedor e modelo padrão
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:3b

# Modelos permitidos (separados por vírgula)
MODELOS_PERMITIDOS=ollama:qwen2.5-coder:3b,openai:gpt-4.1-mini

# Chave da OpenAI: preencha apenas no ambiente local, nunca neste arquivo
OPENAI_API_KEY=
# Tokens de acesso da API, no formato token:usuario separados por vírgula.
# Gere cada token com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Preencha apenas no seu .env local, nunca neste arquivo.
API_TOKENS=